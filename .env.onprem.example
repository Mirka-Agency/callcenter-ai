# On-prem single-employer deploy. Copy to .env before:
#   docker compose -f docker-compose.onprem.yml up -d --build
#
# Critical: APP_URL must be the LAN address Asterisk/Simotel can reach
# (not localhost if the PBX is on another machine).
# See docs/on-prem.md

APP_NAME="آوایار"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://10.0.0.50:8000

# Plain HTTP on LAN: do not force HTTPS (cloud CapRover uses https:// APP_URL instead)
FORCE_HTTPS=false
SESSION_SECURE_COOKIE=false

APP_LOCALE=fa
APP_FALLBACK_LOCALE=fa
APP_FAKER_LOCALE=fa_IR

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stderr
LOG_LEVEL=info

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=callcenter
DB_USERNAME=callcenter
DB_PASSWORD=change-me-db-password

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb

REVERB_APP_ID=onprem-app
REVERB_APP_KEY=change-me-reverb-key
REVERB_APP_SECRET=change-me-reverb-secret
REVERB_HOST=localhost
REVERB_PORT=8090
REVERB_SERVER_PORT=8090
REVERB_SCHEME=http

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

FILESYSTEM_DISK=local
RECORDINGS_DISK=local
RECORDINGS_PLAYBACK_URL_TTL=120
RECORDINGS_RETENTION_DAYS=30
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@localhost"
MAIL_FROM_NAME="${APP_NAME}"

# Container roles (compose sets these; keep for clarity)
CONTAINER_ROLE=web
RUN_MIGRATIONS=true

# OnPremSeeder — change before first seed; admin stays with your team
ONPREM_ADMIN_NAME="Super Admin"
ONPREM_ADMIN_EMAIL=admin@example.com
ONPREM_ADMIN_PASSWORD=change-me-admin-password

ONPREM_EMPLOYER_NAME="مدیر سازمان"
ONPREM_EMPLOYER_EMAIL=employer@example.com
ONPREM_EMPLOYER_PASSWORD=change-me-employer-password

ONPREM_ORG_TITLE="سازمان محلی"
ONPREM_WALLET_BALANCE=50000000
ONPREM_EMPLOYER_CAN_MANAGE_INTEGRATIONS=true
